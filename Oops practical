[10/19, 1:29 PM] Atharv Butle: class ForLoop {
    public static void main(String[] args) {

        int[][] arr = {
            {10, 20, 30},
            {40, 50, 60}
        };

        for (int i = 0; i < arr.length; i++) {
            for (int j = 0; j < arr[i].length; j++) {
                System.out.print(arr[i][j] + " ");
            }
            System.out.println();
        }
    }
}

[10/19, 1:29 PM] Atharv Butle: class WhileLoop {
    public static void main(String[] args) {

        int[][] arr = {
            {10, 20, 30},
            {40, 50, 60}
        };

        int i = 0;

        while (i < arr.length) {
            int j = 0;

            while (j < arr[i].length) {
                System.out.print(arr[i][j] + " ");
                j++;
            }

            System.out.println();
            i++;
        }
    }
}
